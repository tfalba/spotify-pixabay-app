# ───────────────────────────────
# 🌍 GLOBAL (shared by client + server)
# ───────────────────────────────

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
coverage/
.cache/
.tmp/
temp/
*.log
*.local

# Environment files (keep secrets out of Git)
.env
.env.*
!.env.example    # allow env template to be tracked

# TypeScript
*.tsbuildinfo

# Package manager locks (optional to ignore)
# Uncomment if you prefer not to commit lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ───────────────────────────────
# 🔹 CLIENT (Vite + React)
# ───────────────────────────────

# Output and cache
client/dist/
client/.vite/
client/.vercel/
client/node_modules/

# Local dev / preview cache
client/.DS_Store
client/*.local

# Generated files
client/src/__generated__/
client/src/generated/

# ───────────────────────────────
# 🔹 SERVER (Express + TypeScript)
# ───────────────────────────────

# Build / transpiled output
server/dist/
server/build/
server/**/*.js.map

# Environment + runtime
server/.env
server/logs/
server/tmp/
server/uploads/
server/.cache/
server/*.log

# ───────────────────────────────
# 🧪 TEST / COVERAGE / DEBUG
# ───────────────────────────────

coverage/
jest-cache/
jest-output/
.vitest/
.vscode-test/
*.pid
*.seed
*.pid.lock
*.tgz

# ───────────────────────────────
# 💻 EDITOR / OS FILES
# ───────────────────────────────

# IDE configs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/

# Windows metadata
Thumbs.db
ehthumbs.db
Desktop.ini

# ───────────────────────────────
# 🧩 TOOL / DEPLOYMENT FILES
# ───────────────────────────────

# Local service caches
.vercel/
.netlify/
firebase-debug.log
